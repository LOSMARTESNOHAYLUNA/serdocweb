{
  "headers": [
    {
      "source": "/sitemap.xsl",
      "headers": [
        { "key": "Content-Type", "value": "text/xsl; charset=utf-8" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!web/).*)",
      "has": [{ "type": "host", "value": "www.serdoc.es" }],
      "destination": "https://serdoc.es/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/web/:path*",
      "destination": "https://origen.serdoc.es/web/:path*"
    }
  ]
}
